<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <item
        android:id="@+id/action_search"
        android:title="@string/menu_item_search"
        android:icon="@drawable/ic_search"
        app:showAsAction="always|collapseActionView"
        app:actionViewClass="androidx.appcompat.widget.SearchView" />

    <item
        android:id="@+id/sort"
        android:title="@string/menu_item_sort"
        android:icon="@drawable/ic_sort"
        app:showAsAction="always"
        tools:ignore="AlwaysShowAction">

        <menu>
            <group
                android:id="@+id/group_criteria"
                android:checkableBehavior="single">

                <item
                    android:id="@+id/sort_name"
                    android:title="@string/menu_item_sort_name"
                    app:showAsAction="never" />

                <item
                    android:id="@+id/sort_value"
                    android:title="@string/menu_item_sort_current_saving"
                    app:showAsAction="never" />

                <item
                    android:id="@+id/sort_goal"
                    android:title="@string/menu_item_sort_goal"
                    app:showAsAction="never" />

                <item
                    android:id="@+id/sort_deadline"
                    android:title="@string/menu_item_sort_deadline"
                    app:showAsAction="never" />
            </group>
            <group
                android:id="@+id/group_order"
                android:checkableBehavior="single">

                <item
                    android:id="@+id/sort_ascending"
                    android:title="@string/menu_item_sort_ascending"
                    app:showAsAction="never" />

                <item
                    android:id="@+id/sort_descending"
                    android:title="@string/menu_item_sort_descending"
                    app:showAsAction="never" />
            </group>
        </menu>
    </item>

    <item
        android:id="@+id/archive"
        android:title="@string/menu_item_archive"
        app:showAsAction="never" />

    <item
        android:id="@+id/settings"
        android:title="@string/menu_item_settings"
        app:showAsAction="never" />

    <item
        android:id="@+id/about"
        android:title="@string/menu_item_about"
        app:showAsAction="never" />

</menu>
