<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Title and Status Chip -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/details_name"
            android:text="Vacation Fund"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:ignore="HardcodedText" />

        <com.google.android.material.chip.Chip
            android:id="@+id/details_category_chip"
            style="@style/Widget.Material3.Chip.Assist.Elevated"
            android:text="🎯 General"
            android:clickable="false"
            android:layout_marginEnd="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="HardcodedText" />

        <com.google.android.material.chip.Chip
            android:id="@+id/details_status_chip"
            style="@style/Widget.Material3.Chip.Assist.Elevated"
            android:text="In Progress"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- Progress Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Filled"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        android:layout_marginBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/details_current_amount"
                    android:text="$1,500.00"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/details_goal_amount"
                    android:text=" of $2,000.00"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/details_percent"
                    android:text="75%"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/details_progress"
                android:max="100"
                app:trackThickness="10dp"
                app:trackCornerRadius="5dp"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorSurfaceContainerHighest"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/details_remaining_subtext"
                android:text="$500.00 left to reach goal"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Smart Insight Card (Deadline & Daily Pace) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/details_insight_card"
        style="@style/Widget.Material3.CardView.Outlined"
        app:cardCornerRadius="18dp"
        app:strokeColor="?attr/colorOutlineVariant"
        android:layout_marginBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/details_deadline_text"
                android:text="📅 Deadline: 12/25/2026 (14 days left)"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:ignore="HardcodedText" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/details_pace_text"
                android:text="💡 Recommended pace: Save $35.71 / day to reach on time"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Notes Section -->
    <!-- 1. Notes Card (when notes exist) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/details_notes_card"
        style="@style/Widget.Material3.CardView.Filled"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Notes Header with Copy and Edit Action Icons -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_edit_note"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="6dp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    tools:ignore="ContentDescription" />

                <com.google.android.material.textview.MaterialTextView
                    android:text="NOTES &amp; REMINDERS"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="?attr/colorPrimary"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/details_btn_copy_note"
                    style="@style/Widget.Material3.Button.IconButton"
                    app:icon="@drawable/ic_content_copy"
                    app:iconTint="?attr/colorOnSurfaceVariant"
                    app:iconSize="18dp"
                    android:tooltipText="Copy Note"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/details_btn_edit_note"
                    style="@style/Widget.Material3.Button.IconButton"
                    app:icon="@drawable/ic_edit_note"
                    app:iconTint="?attr/colorOnSurfaceVariant"
                    app:iconSize="20dp"
                    android:tooltipText="Edit Note"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Vertical Accent Quote Bar -->
                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:background="?attr/colorPrimary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/details_notes_text"
                    android:text="Save for flights and hotel in Tokyo"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingExtra="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. Empty Notes Prompt (when no notes exist) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/details_btn_add_note"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:icon="@drawable/ic_add"
        app:iconTint="?attr/colorOnSurfaceVariant"
        android:text="Add note or milestone"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:cornerRadius="16dp"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="HardcodedText" />

    <!-- Action Buttons -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/details_btn_transact"
            style="@style/Widget.Material3.Button"
            app:icon="@drawable/ic_add_circle"
            android:text="Transact"
            app:cornerRadius="14dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/details_btn_history"
            style="@style/Widget.Material3.Button.TonalButton"
            app:icon="@drawable/ic_history"
            android:text="History"
            app:cornerRadius="14dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- Bottom Secondary Actions -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/details_btn_edit"
            style="?attr/materialButtonOutlinedStyle"
            app:icon="@drawable/ic_save"
            android:text="Edit"
            app:cornerRadius="14dp"
            android:layout_marginEnd="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/details_btn_share"
            style="?attr/materialButtonOutlinedStyle"
            app:icon="@drawable/ic_share"
            android:text="Share"
            app:cornerRadius="14dp"
            android:layout_marginEnd="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="HardcodedText" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/details_btn_archive"
            style="?attr/materialButtonOutlinedStyle"
            app:icon="@drawable/ic_archive"
            android:text="Archive"
            app:cornerRadius="14dp"
            android:layout_marginEnd="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/details_btn_delete"
            style="?attr/materialButtonOutlinedStyle"
            app:icon="@drawable/ic_delete"
            app:iconTint="?attr/colorError"
            android:textColor="?attr/colorError"
            app:strokeColor="?attr/colorError"
            android:text="Delete"
            app:cornerRadius="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</LinearLayout>
