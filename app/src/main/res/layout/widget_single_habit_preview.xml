<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_widget_preview_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pushups"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14d streak"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="8 / 10 reps today"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_primary" />

    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="80"
        android:progressTint="@color/md_theme_primary"
        android:progressBackgroundTint="@color/md_theme_surfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="-1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:background="@drawable/bg_widget_pill_neutral" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="+1 rep"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onPrimaryContainer"
            android:background="@drawable/bg_widget_pill_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="Done"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onPrimaryContainer"
            android:background="@drawable/bg_widget_pill_primary" />
    </LinearLayout>
</LinearLayout>
