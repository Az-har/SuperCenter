<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/bg_widget_preview_card">

    <!-- Header: Habit Title, Streak Flame, Range Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pushups  🔥 14d"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onSurface" />
    </LinearLayout>

    <!-- 7-Column Contribution Calendar Grid Preview (Sun..Sat x 4 weeks) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:orientation="vertical">

        <!-- Week 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_0" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_1" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_2" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_3" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_4" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_2" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_3" android:contentDescription="@null" />
        </LinearLayout>

        <!-- Week 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_2" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_3" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_4" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_2" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_1" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_3" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_4" android:contentDescription="@null" />
        </LinearLayout>

        <!-- Week 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_3" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_4" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_2" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_1" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_3" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_4" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_2" android:contentDescription="@null" />
        </LinearLayout>

        <!-- Week 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_1" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_2" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_3" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_4" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_3" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_0" android:contentDescription="@null" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/bg_heatmap_tile_0" android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer: Quota status + Legend -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Today: 8/10 reps"
            android:textSize="11sp"
            android:textColor="@color/md_theme_onSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Less "
            android:textSize="10sp"
            android:textColor="@color/md_theme_onSurfaceVariant" />
        <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_margin="1dp" android:background="@drawable/bg_heatmap_tile_0" android:contentDescription="@null" />
        <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_margin="1dp" android:background="@drawable/bg_heatmap_tile_1" android:contentDescription="@null" />
        <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_margin="1dp" android:background="@drawable/bg_heatmap_tile_2" android:contentDescription="@null" />
        <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_margin="1dp" android:background="@drawable/bg_heatmap_tile_4" android:contentDescription="@null" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" More"
            android:textSize="10sp"
            android:textColor="@color/md_theme_onSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
