<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/debt_parent"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="8dp"
    app:cardElevation="1dp"
    app:cardCornerRadius="22dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header: Title, Category Badge, Payoff Percent Badge -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/debt_name"
                android:text="Credit Card"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:ignore="HardcodedText" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/debt_type_badge"
                android:text="💸 I Owe"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textStyle="bold"
                android:textColor="?attr/colorOnErrorContainer"
                android:background="@drawable/bg_pill_error"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="HardcodedText" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/debt_category_badge"
                android:text="💳 Credit Card"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:background="@drawable/bg_pill_neutral"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="HardcodedText" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/debt_percent"
                android:text="0% Paid"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textStyle="bold"
                android:textColor="?attr/colorOnErrorContainer"
                android:background="@drawable/bg_pill_error"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Remaining Debt vs Total Debt -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/debt_remaining_amount"
                android:text="$1,500.00"
                android:textColor="?attr/colorError"
                android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="HardcodedText" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/debt_remaining_label"
                android:text=" remaining"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Subtext: Total borrowed & paid so far -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/debt_subtext"
            android:text="Total Borrowed: $2,000.00 | Paid: $500.00"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="HardcodedText" />

        <!-- Linear Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/debt_progress"
            android:max="100"
            app:trackThickness="10dp"
            app:trackCornerRadius="5dp"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="?attr/colorSurfaceContainerHighest"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Deadline / Due Date -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/debt_deadline"
            android:text="Target Payoff: 12/25/2026"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="HardcodedText" />

        <!-- Notes Preview -->
        <LinearLayout
            android:id="@+id/debt_notes_container"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_edit_note"
                app:tint="?attr/colorOnSurfaceVariant"
                android:layout_marginEnd="6dp"
                android:alpha="0.8"
                android:layout_width="16dp"
                android:layout_height="16dp"
                tools:ignore="ContentDescription" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/debt_notes_preview"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="italic"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Monthly minimum $50. Aiming to clear before summer." />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.5" />

        <!-- Action Row -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Primary Make Payment Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_debt_pay"
                style="@style/Widget.Material3.Button.TonalButton"
                app:icon="@drawable/ic_add_circle"
                app:iconSize="16dp"
                android:text="@string/action_make_payment"
                app:cornerRadius="14dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:minHeight="48dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Space
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_debt_history"
                style="?attr/materialIconButtonStyle"
                app:icon="@drawable/ic_history"
                app:iconTint="?attr/colorSecondary"
                android:contentDescription="@string/action_payment_history"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_debt_archive"
                style="?attr/materialIconButtonStyle"
                app:icon="@drawable/ic_archive"
                app:iconTint="?attr/colorSecondary"
                android:contentDescription="@string/action_archive_debt"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_debt_unarchive"
                style="?attr/materialIconButtonStyle"
                app:icon="@drawable/ic_unarchive"
                app:iconTint="?attr/colorSecondary"
                android:contentDescription="@string/action_unarchive_debt"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_debt_delete"
                style="?attr/materialIconButtonStyle"
                app:icon="@drawable/ic_delete"
                app:iconTint="?attr/colorError"
                android:contentDescription="@string/action_delete_debt"
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
